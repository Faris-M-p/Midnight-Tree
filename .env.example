# Public Supabase (safe for the browser / Next.js client)
# Prefer Publishable key (sb_publishable_...). If the SDK rejects it, use Legacy anon JWT (eyJ...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used when generating invitation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Secret key (sb_secret_... or legacy service_role JWT). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Never put Razorpay secrets in NEXT_PUBLIC_* — Edge Function secrets only.
