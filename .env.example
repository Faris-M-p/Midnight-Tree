# Public Supabase (safe for the browser / Next.js client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used when generating invitation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put service role or Razorpay secret in NEXT_PUBLIC_* vars.
# Those belong in Supabase Edge Function secrets / server env only.
