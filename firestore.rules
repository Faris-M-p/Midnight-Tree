rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /families/{familyId} {
      allow read, write: if signedIn();
    }

    match /familyMembers/{accessId} {
      allow read, write: if signedIn();
    }

    match /members/{memberId} {
      allow read, write: if signedIn();
    }

    match /relationships/{relationshipId} {
      allow read, write: if signedIn();
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if signedIn();
    }

    match /albums/{albumId} {
      allow read, write: if signedIn();
    }

    match /albumPhotos/{photoId} {
      allow read, write: if signedIn();
    }

    match /stories/{storyId} {
      allow read, write: if signedIn();
    }

    match /memories/{memoryId} {
      allow read, write: if signedIn();
    }

    match /memoryPhotos/{photoId} {
      allow read, write: if signedIn();
    }

    match /events/{eventId} {
      allow read, write: if signedIn();
    }

    match /accessTokens/{tokenId} {
      allow get: if true;
      allow list, create, update, delete: if signedIn();
    }
  }
}
